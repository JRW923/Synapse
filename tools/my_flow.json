[
  {
    "name": "01-home-firstrun",
    "url": "http://localhost:8000/",
    "note": "首屏：未配置模型时自动弹出设置面板（首次进入的真实状态）",
    "highlight": "#settings .box",
    "actions": [{"type": "wait", "selector": "#settings.show"}]
  },
  {
    "name": "02-settings-free-model",
    "url": "http://localhost:8000/",
    "note": "设置面板：选择「使用免费模型」，填 OpenRouter Key 即可免付费试用",
    "highlight": "#cfg-free",
    "actions": [
      {"type": "wait", "selector": "#settings.show"},
      {"type": "click", "selector": "text=使用免费模型"},
      {"type": "wait", "selector": "#cfg-free:not([hidden])"}
    ]
  },
  {
    "name": "03-help",
    "url": "http://localhost:8000/",
    "note": "功能指引弹窗：会话/待办/评分/上下文报告等说明",
    "highlight": "#help .box",
    "actions": [
      {"type": "click", "selector": "text=关闭"},
      {"type": "click", "selector": "text=?"},
      {"type": "wait", "selector": "#help.show"}
    ]
  },
  {
    "name": "04-connect-local",
    "url": "http://localhost:8000/",
    "note": "连接本机工作区：生成配对码，本机运行 synapse connect 认领",
    "highlight": "#pair-code",
    "actions": [
      {"type": "click", "selector": "text=关闭"},
      {"type": "click", "selector": "text=连接本机"},
      {"type": "wait", "selector": "#pair"}
    ]
  },
  {
    "name": "05-send-no-key-error",
    "url": "http://localhost:8000/",
    "note": "错误态：未配模型就发任务，提示先填 API Key",
    "highlight": ".msg.agent .body",
    "actions": [
      {"type": "click", "selector": "text=关闭"},
      {"type": "fill", "selector": "#input", "value": "列出当前目录的文件"},
      {"type": "click", "selector": "#sendbtn"},
      {"type": "wait_ms", "ms": 1500}
    ]
  }
]
