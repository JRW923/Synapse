[
  {
    "name": "01-home-firstrun",
    "url": "http://localhost:8000/",
    "note": "首屏：未配置模型时设置面板会自动弹出（已配置则显示干净首页）",
    "highlight": "#input",
    "actions": [{"type": "wait", "selector": "#main"}]
  },
  {
    "name": "02-settings-free-model",
    "url": "http://localhost:8000/",
    "note": "设置面板：选择「使用免费模型」，填 OpenRouter Key 即可免付费试用",
    "highlight": "#cfg-free",
    "actions": [
      {"type": "click", "selector": "text=设置"},
      {"type": "wait", "selector": "#settings.show"},
      {"type": "click", "selector": "text=使用免费模型"},
      {"type": "wait", "selector": "#cfg-free:not([hidden])"}
    ]
  },
  {
    "name": "03-help",
    "url": "http://localhost:8000/",
    "note": "功能指引弹窗：会话/待办/评分/上下文报告等说明",
    "highlight": "#help .box",
    "actions": [
      {"type": "click_if_exists", "selector": "text=关闭"},
      {"type": "click", "selector": "text=?"},
      {"type": "wait", "selector": "#help.show"}
    ]
  },
  {
    "name": "04-connector",
    "url": "http://localhost:8000/",
    "note": "本机工作区已自动连接（单进程 synapse serve 无需手动配对）",
    "highlight": "#connector",
    "actions": [
      {"type": "click_if_exists", "selector": "text=关闭"},
      {"type": "wait", "selector": "#connector:not(:empty)"}
    ]
  },
  {
    "name": "05-send-task",
    "url": "http://localhost:8000/",
    "note": "发送任务：未配模型时提示先填 Key；已配则真实运行",
    "highlight": ".msg.agent .body",
    "actions": [
      {"type": "click_if_exists", "selector": "text=关闭"},
      {"type": "fill", "selector": "#input", "value": "列出当前目录的文件"},
      {"type": "click", "selector": "#sendbtn"},
      {"type": "wait_ms", "ms": 1500}
    ]
  }
]
